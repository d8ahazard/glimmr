# Runtime dependencies for the Glimmr ambient-lighting service.
#
# Glimmr is shipped as a self-contained .NET 8 publish (see
# files/archive.tgz), so we don't need any -dev/headers packages here.
# The native OpenCV binaries that Emgu.CV bundles (Emgu.CV.runtime.
# debian-arm64) link dynamically against the libs below; everything
# else has been removed to keep the image small.

# mDNS / discovery
avahi-daemon
libnss-mdns

# Audio (Glimmr captures USB audio on appliance mode)
alsa-utils
libasound2

# FFmpeg / video runtime (covers libavcodec/libavformat/libavutil/libswscale/...)
ffmpeg
libavcodec-extra
libv4l-0

# Image / codec runtimes used by OpenCV
libjpeg62-turbo
libpng16-16
libtiff6
libwebp7
libopenexr-3-1-30
libtesseract5
libgeotiff5

# OpenCV optional/dependent runtimes
libgstreamer1.0-0
libgtk-3-0
libtbb12
libatlas3-base
libdc1394-25
# Emgu.CV's libcvextern.so links against VTK (viz module) - without this the
# app aborts on the first Mat allocation and never starts.
libvtk9.1

# X11 helpers (used by Glimmr's screen capture path on desktop builds;
# safe to keep on a headless image -- they're tiny and avoid surprises
# if a user hooks up a display).
xauth
x11-xserver-utils

# .NET globalization
libicu72

# Build tools needed by stage2/06-pi5-ws281x to compile the kernel
# module against linux-headers-rpi-2712. (build-essential and git are
# already installed by stage2/01-sys-tweaks.)
