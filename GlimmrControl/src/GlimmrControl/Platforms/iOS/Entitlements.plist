<plist version="1.0">
<dict>
	<!-- Join the Glimmr setup hotspot during onboarding. -->
	<key>com.apple.developer.networking.HotspotConfiguration</key>
	<true/>
	<!-- Read the current Wi-Fi SSID (NEHotspotNetwork.FetchCurrent). -->
	<key>com.apple.developer.networking.wifi-info</key>
	<true/>
</dict>
</plist>
