<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:GlimmrControl"
             x:Class="GlimmrControl.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Styles/GlimmrStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:ReachabilityToColorConverter x:Key="Dot" />
            <local:StringNotEmptyConverter x:Key="StringNotEmpty" />
            <local:InvertedBoolConverter x:Key="InvertedBool" />
            <local:PathDataConverter x:Key="PathData" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
