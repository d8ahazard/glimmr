<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GlimmrControl.Core.RoomCalibrationPage"
             BackgroundColor="#111"
             xmlns:ios="clr-namespace:Xamarin.Forms.PlatformConfiguration.iOSSpecific;assembly=Xamarin.Forms.Core"
             xmlns:core="clr-namespace:GlimmrControl.Core;assembly=GlimmrControl.Core"
             ios:Page.UseSafeArea="true"
             Title="Room Calibration">

    <ContentPage.Content>
        <Grid RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <core:MenuBar x:Name="topMenuBar" Grid.Row="0" />

            <!-- Camera preview area / status display -->
            <Grid Grid.Row="1" BackgroundColor="#000" Padding="0">
                <!-- WebView renders the camera feed from the Glimmr box calibration page -->
                <WebView x:Name="CameraView" IsVisible="False"
                         VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" />

                <!-- Status/instruction overlay -->
                <StackLayout x:Name="InstructionOverlay"
                             VerticalOptions="Center" HorizontalOptions="Center"
                             Padding="30">
                    <Label x:Name="StepIcon" Text="&#x1F4F7;" FontSize="60"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="StepTitle" Text="Room Calibration"
                           FontSize="28" FontAttributes="Bold" TextColor="White"
                           HorizontalTextAlignment="Center" Margin="0,10,0,5" />
                    <Label x:Name="StepDescription"
                           Text="Map your lights in 3D space so Glimmr can create immersive spatial effects."
                           FontSize="16" TextColor="#AAA"
                           HorizontalTextAlignment="Center" Margin="0,0,0,20" />
                </StackLayout>

                <!-- Progress indicator during calibration -->
                <StackLayout x:Name="ProgressOverlay" IsVisible="False"
                             VerticalOptions="Center" HorizontalOptions="Center"
                             Padding="30">
                    <ActivityIndicator x:Name="SpinnerIndicator" IsRunning="True"
                                       Color="#4488FF" HeightRequest="50" WidthRequest="50" />
                    <Label x:Name="ProgressLabel" Text="Calibrating..."
                           FontSize="20" TextColor="White"
                           HorizontalTextAlignment="Center" Margin="0,15,0,5" />
                    <Label x:Name="ProgressDetail" Text=""
                           FontSize="14" TextColor="#888"
                           HorizontalTextAlignment="Center" />
                    <ProgressBar x:Name="CalibrationProgress" Progress="0"
                                 ProgressColor="#4488FF" Margin="20,10" />
                </StackLayout>

                <!-- Results display -->
                <StackLayout x:Name="ResultsOverlay" IsVisible="False"
                             VerticalOptions="Center" HorizontalOptions="Center"
                             Padding="30">
                    <Label x:Name="ResultIcon" Text="&#x2705;" FontSize="60"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="ResultTitle" Text="Calibration Complete!"
                           FontSize="28" FontAttributes="Bold" TextColor="White"
                           HorizontalTextAlignment="Center" Margin="0,10,0,5" />
                    <Label x:Name="ResultDetail" Text=""
                           FontSize="16" TextColor="#AAA"
                           HorizontalTextAlignment="Center" Margin="0,0,0,10" />
                    <Label x:Name="ResultEmitters" Text=""
                           FontSize="14" TextColor="#666"
                           HorizontalTextAlignment="Center" />
                </StackLayout>
            </Grid>

            <!-- Step indicator -->
            <StackLayout Grid.Row="2" Orientation="Horizontal"
                         HorizontalOptions="Center" Padding="10,5"
                         BackgroundColor="#181818">
                <BoxView x:Name="Step1Dot" WidthRequest="12" HeightRequest="12"
                         CornerRadius="6" Color="#4488FF" Margin="4" />
                <BoxView x:Name="Step2Dot" WidthRequest="12" HeightRequest="12"
                         CornerRadius="6" Color="#444" Margin="4" />
                <BoxView x:Name="Step3Dot" WidthRequest="12" HeightRequest="12"
                         CornerRadius="6" Color="#444" Margin="4" />
                <BoxView x:Name="Step4Dot" WidthRequest="12" HeightRequest="12"
                         CornerRadius="6" Color="#444" Margin="4" />
                <BoxView x:Name="Step5Dot" WidthRequest="12" HeightRequest="12"
                         CornerRadius="6" Color="#444" Margin="4" />
            </StackLayout>

            <!-- Action button -->
            <Button x:Name="ActionButton" Grid.Row="3"
                    Text="Start Calibration"
                    FontSize="20" FontAttributes="Bold"
                    TextColor="White" BackgroundColor="#4488FF"
                    CornerRadius="12" HeightRequest="60"
                    Margin="20,5,20,20"
                    Clicked="OnActionButtonClicked" />
        </Grid>
    </ContentPage.Content>
</ContentPage>
